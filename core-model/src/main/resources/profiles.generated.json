        },
        {
          "blueprint": "term_contrast",
          "label": "词义辨析双栏表",
          "description": "对比日常汉语直觉与作者专属定义（附原词）"
        },
        {
          "blueprint": "lineage_dag",
          "label": "批判谱系图",
          "description": "呈现思想家、学派之间的继承、改造与批判关系"
        }
      ],
      "extensions": [
        {
          "action": "sparring_dossier",
          "label": "学术交锋档案",
          "hint": "拆解核心论战交锋并剖析经典思想实验与隐喻",
          "cross_search": false
        },
        {
          "action": "counterexample_lab",
          "label": "反例与现实检验",
          "hint": "揪出隐含前提、构造极端反例并检验当代适用边界",
          "cross_search": false
        }
      ]
    },
    {
      "read_type": "social",
      "name": "社会科学",
      "adler_category": "6. 社会科学",
      "goal": "以议题为中心：厘清混杂术语、多变量因果反馈与跨作者对照",
      "sub_kind": "",
      "sub_kind_hint": "",
      "blueprints": [
        {
          "blueprint": "causal_loop",
          "label": "因果反馈回路图",
          "description": "标出 + / - 反馈、滞后与锁定回路"
        },
        {
          "blueprint": "concept_matrix",
          "label": "跨学派概念矩阵",
          "description": "对照不同学派与政策立场对同一概念的界定分歧"
        },
        {
          "blueprint": "metric_chart",
          "label": "实证数据与指标图",
          "description": "还原原文真实统计数字，纯定性章节诚实退场"
        }
      ],
      "extensions": [
        {
          "action": "method_audit",
          "label": "方法与样本局限",
          "hint": "识别本章研究方法、因果识别偏差与后续演进边界，并联动书库跨书综述",
          "cross_search": true
        },
        {
          "action": "actor_incentives",
          "label": "行动者激励与博弈",
          "hint": "拆解各方利益主体的目标激励、约束条件与博弈策略",
          "cross_search": false
        }
      ]
    },
