<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow cleartext HTTP at the Android platform layer because <domain-config>
    cannot express RFC 1918 private subnets (10/8, 172.16/12, 192.168/16) or
    Tailscale CGNAT (100.64.0.0/10) IP ranges for desktop gateway and LAN share.
    Cleartext HTTP to public hosts/IPs is strictly blocked in Kotlin by
    SyncEndpointUrlPolicy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
